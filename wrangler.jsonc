// Cloudflare Workers static-assets project (ADR-017). Assets only: there is no
// `main` script, no bindings and no secrets (CLAUDE.md rule 7). Workers Builds
// runs `pnpm run build` and then deploys `apps/web/dist`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remode",
  // Must not be later than the workerd bundled with the pinned wrangler.
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./apps/web/dist",
    // Unknown paths get /index.html with 200 (client-side routing).
    "not_found_handling": "single-page-application",
  },
}
